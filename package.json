{
  "name": "life-planner",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun src/server.ts",
    "preview": "bun dist/server.js",
    "health:import": "bun scripts/import-health.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "type:check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.99",
    "@effect/sql-pg": "4.0.0-beta.99",
    "effect": "4.0.0-beta.99"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
