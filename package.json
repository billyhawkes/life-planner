{
  "name": "life-planner",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "start": "bun src/server.ts",
    "preview": "bun dist/server.js",
    "db:migrate": "bun scripts/migrate.ts",
    "type:check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "bun test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/sql-pg": "4.0.0-rc.116",
    "@zip.js/zip.js": "2.8.34",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
